```gitignore
# Python virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Frontend dependencies and build output
node_modules/
dist/

# Local databases
data/taskpilot.db
*.db-shm
*.db-wal

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
```